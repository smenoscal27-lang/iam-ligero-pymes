# Configuración del Servidor IAM
PORT=3000
NODE_ENV=development

# Base de Datos SQLite
DB_PATH=./iam.sqlite

# Configuración Inicial de Super Administrador (Ciberseguridad)
DEFAULT_ADMIN_NAME="Super Administrador"
DEFAULT_ADMIN_EMAIL=admin@iam-pymes.local
DEFAULT_ADMIN_PASSWORD=AdminPass123!*Segura

# Configuración de Seguridad JWT
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui
JWT_EXPIRES_IN=1h

# Clave Criptográfica para Cifrado en Reposo de Secretos 2FA (AES-256-GCM)
TWO_FACTOR_ENCRYPTION_KEY=tu_clave_de_cifrado_aes_256_gcm_aqui
